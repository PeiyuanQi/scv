{
  "display_information": {"name": "SCV"},
  "features": {
    "bot_user": {"display_name": "SCV", "always_online": false},
    "app_home": {"messages_tab_enabled": true, "messages_tab_read_only_enabled": false}
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "files:read",
        "files:write",
        "groups:history",
        "im:history",
        "im:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {"bot_events": ["app_mention", "message.im"]},
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
